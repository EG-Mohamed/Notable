{
    "name": "eg-mohamed/notable",
    "description": "This is my package notable",
    "keywords": [
        "laravel",
        "notable"
    ],
    "homepage": "https://github.com/eg-mohamed/notable",
    "license": "MIT",
    "authors": [
        {
            "name": "Mohamed Said",
            "email": "me@msaied.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "spatie/laravel-package-tools": "^1.93.1",
        "illuminate/contracts": "^12.0||^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "nunomaduro/collision": "^8.9.5",
        "orchestra/testbench": "^11.0||^10.6.0",
        "pestphp/pest": "^4.4.1",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "MohamedSaid\\Notable\\": "src/",
            "MohamedSaid\\Notable\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MohamedSaid\\Notable\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MohamedSaid\\Notable\\NotableServiceProvider"
            ],
            "aliases": {
                "Notable": "MohamedSaid\\Notable\\Facades\\Notable"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
